[node name="CreditsBody" type="Label" parent="Center/CreditsPanel/CreditsBox/CreditsScroll"]
custom_minimum_size = Vector2(880, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 27
text = "Larry Costigan - Game Designer & Developer
Course: GAME 266 - Core Principles: Game Tech
Instructor: Prof. James Taylor

THIRD-PARTY ASSETS

Models (all licensed under CC BY 4.0, creativecommons.org/licenses/by/4.0):
\"Cute Astronaut\" by haefu
\"One-eyed Monster with animations\" by Jungle Jim
\"Rocket\" by Rafa Andrade
\"Simple Ray Gun\" by Playblast
\"Wall Ready For Construction\" by Mehdi Shahsavan

Sound effects from Pixabay: distant bang, scorpion claw attack, footsteps on hard floor, sci-fi gun shoot, ough, rocket launch, slime, cartoon rocket whoosh.

Music: \"Video Game Pixel Chiptune Music\" by alex-morgan on Pixabay, used under the Pixabay Content License."
autowrap_mode = 3

