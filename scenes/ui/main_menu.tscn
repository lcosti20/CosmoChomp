[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_menu.gd" id="1_menu"]

[sub_resource type="SystemFont" id="SystemFont_bold"]
font_weight = 700

[sub_resource type="StyleBoxFlat" id="StyleBox_button"]
bg_color = Color(0.15, 0.2, 0.35, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 80.0
content_margin_top = 12.0
content_margin_right = 80.0
content_margin_bottom = 12.0

[sub_resource type="StyleBoxFlat" id="StyleBox_button_hover"]
bg_color = Color(0.22, 0.29, 0.48, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 80.0
content_margin_top = 12.0
content_margin_right = 80.0
content_margin_bottom = 12.0

[sub_resource type="StyleBoxFlat" id="StyleBox_focus"]
draw_center = false
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 0.8, 0.2, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="StyleBox_credits"]
