content_margin_left = 40.0
content_margin_top = 30.0
content_margin_right = 40.0
content_margin_bottom = 30.0

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="MainPanel" type="VBoxContainer" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/MainPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.8, 0.2, 1)
theme_override_fonts/font = SubResource("SystemFont_bold")
theme_override_font_sizes/font_size = 160
text = "Cosmo Chomp"
horizontal_alignment = 1

[node name="TitleSpacer" type="Control" parent="Center/MainPanel"]
custom_minimum_size = Vector2(0, 30)
layout_mode = 2

[node name="StartButton" type="Button" parent="Center/MainPanel"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
theme_override_fonts/font = SubResource("SystemFont_bold")
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("StyleBox_button")
theme_override_styles/hover = SubResource("StyleBox_button_hover")
theme_override_styles/pressed = SubResource("StyleBox_button")
theme_override_styles/focus = SubResource("StyleBox_focus")
text = "Start"

[node name="CreditsButton" type="Button" parent="Center/MainPanel"]
